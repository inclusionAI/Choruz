CHORUZ_PG_BIN=postgres
CHORUZ_INITDB_BIN=initdb
CHORUZ_PG_CTL_BIN=pg_ctl
CHORUZ_CREATEDB_BIN=createdb
CHORUZ_DROPDB_BIN=dropdb
CHORUZ_PSQL_BIN=psql
CHORUZ_PG_DUMP_BIN=pg_dump

CHORUZ_RUNTIME_DIR=.choruz-runtime
CHORUZ_DATA_DIR=.choruz-runtime/data
CHORUZ_LOG_DIR=.choruz-runtime/logs
RUST_LOG=info
CHORUZ_LOG_FORMAT=human
CHORUZ_ATTACHMENT_DIR=.choruz-runtime/attachments
CHORUZ_BACKUP_DIR=.choruz-runtime/backups

CHORUZ_PG_HOST=127.0.0.1
CHORUZ_PG_PORT=5432
CHORUZ_API_HOST=127.0.0.1
CHORUZ_API_PORT=3000
CHORUZ_WEB_PORT=3100
CHORUZ_PIPELINE_METRICS_PORT=3020

CHORUZ_PG_USER=
CHORUZ_PG_DB=choruz
CHORUZ_PG_PASSWORD=choruz
CHORUZ_OPERATOR_WORKSPACE=ws-local
CHORUZ_OPERATOR_USER=operator
CHORUZ_OPERATOR_PASSWORD=choruz-local
CHORUZ_SESSION_SECRET=choruz-local-session-secret
CHORUZ_SESSION_TTL_HOURS=12
